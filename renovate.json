{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": false
  },
  "customManagers": [
    {
      "description": "Scanning tool versions pinned in the adapters. A bump needs re-recorded tool output (tools/record_tool_output.py).",
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/doorcheck/adapters/.+\\.py$/"
      ],
      "matchStrings": [
        "version = \"(?<currentValue>[^\"]+)\"\\s+# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"
      ]
    },
    {
      "description": "Workflow tool inputs, not Action references (owned by Dependabot).",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "version: \"(?<currentValue>[^\"\\r\\n]+)\"[ \\t]+# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"
      ]
    }
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "automerge": false,
  "prConcurrentLimit": 3
}
