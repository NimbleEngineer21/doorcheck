{
  "version": 1,
  "typography": {
    "body-family": "system-ui, sans-serif",
    "mono-family": "ui-monospace, monospace",
    "body-size": "1rem",
    "small-size": "0.875rem",
    "title-size": "clamp(2rem, 5vw, 3.5rem)",
    "line-height": "1.5"
  },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem"
  },
  "layout": {
    "icon-size": "1.5rem",
    "radius": "0.5rem",
    "content-width": "72rem"
  },
  "themes": {
    "light": {
      "background": "#F5F6F8",
      "surface": "#FFFFFF",
      "text": "#202A35",
      "muted": "#526071",
      "border": "#526071",
      "brand": "#25465C",
      "serious": "#B42332",
      "review": "#875000",
      "notice": "#185CB0",
      "info": "#526071",
      "none": "#526071",
      "unavailable": "#526071"
    },
    "dark": {
      "background": "#141B23",
      "surface": "#1D2732",
      "text": "#EEF2F6",
      "muted": "#BAC5D2",
      "border": "#9AAFC4",
      "brand": "#B9D8ED",
      "serious": "#FF9DA5",
      "review": "#F5CB80",
      "notice": "#99C5FF",
      "info": "#BAC5D2",
      "none": "#BAC5D2",
      "unavailable": "#BAC5D2"
    }
  },
  "states": {
    "serious": {
      "icon": "serious",
      "label_key": "severity.serious",
      "description_key": "presentation.serious_description"
    },
    "review": {
      "icon": "review",
      "label_key": "severity.review",
      "description_key": "presentation.review_description"
    },
    "notice": {
      "icon": "notice",
      "label_key": "severity.notice",
      "description_key": "presentation.notice_description"
    },
    "info": {
      "icon": "info",
      "label_key": "severity.info",
      "description_key": "presentation.info_description"
    },
    "none": {
      "icon": "none",
      "label_key": "presentation.none",
      "description_key": "presentation.none_description"
    },
    "unavailable": {
      "icon": "unavailable",
      "label_key": "presentation.unavailable",
      "description_key": "presentation.unavailable_description"
    }
  }
}
