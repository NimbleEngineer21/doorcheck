{
  "version": 1,
  "sources": {
    "datadog-guarddog": {
      "url": "https://securitylabs.datadoghq.com/articles/guarddog-identify-malicious-pypi-packages/",
      "note": "Technique-level rewrites from the published PyPI analyses (including bleurt and sagetesteight), not copies of package payloads. Dataset attribution: Datadog Security Labs, https://github.com/DataDog/malicious-software-packages-dataset . No archives downloaded."
    },
    "solana-release": {
      "url": "https://github.com/solana-foundation/solana-web3.js/releases/tag/v1.95.8",
      "note": "Maintainer disclosure of the npm publish-account compromise and private-key theft. Browser and Home Assistant examples are original adaptations; this is not a reproduction of the original package."
    },
    "osv-copycat": {
      "url": "https://github.com/ossf/malicious-packages/blob/69ce1ab0d67ec6170adf5c3f9fba790ede81f48f/osv/malicious/npm/@solana-labs/web3.js/MAL-2026-5525.json",
      "note": "Public OSV-format report for the differently scoped npm look-alike. The two fictitious Home Assistant identities are an analogy, not a claim about a real integration."
    },
    "ha-model": {
      "url": "https://developers.home-assistant.io/",
      "note": "Original hypothetical Home Assistant models, not observed incidents. The current reader API contracts provide the idioms; no actual integration is accused."
    },
    "guardrails": {
      "url": "https://attack.mitre.org/techniques/T1480/",
      "note": "Original execution-guard model variants (remote, counter, random); not attributed to any particular malware sample."
    }
  },
  "pairs": [
    {
      "id": "credential-file",
      "note": "Private credential-store path versus integration-owned state.",
      "origin": "datadog-guarddog",
      "gaps": [
        "secret-to-network-flow"
      ],
      "adversarial": {
        "files": {
          "probe.py": "00-probe.py.txt"
        },
        "expect": [
          {
            "kind": "ha_private_file",
            "subject": ".storage/auth",
            "path": "probe.py",
            "line": 4
          },
          {
            "kind": "network_host",
            "subject": "example.invalid",
            "path": "probe.py",
            "line": 5
          }
        ],
        "absent": []
      },
      "benign": {
        "files": {
          "probe.py": "00-probe.py.txt"
        },
        "expect": [
          {
            "kind": "network_host",
            "subject": "example.invalid",
            "path": "probe.py",
            "line": 5
          }
        ],
        "absent": [
          "ha_private_file"
        ]
      }
    },
